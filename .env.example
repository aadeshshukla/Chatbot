GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
PORT=3000

# Optional: set AI_PROVIDER=gemini to use Gemini. Groq is the default provider.
# Optional: CONTEXT_CHAR_BUDGET overrides the provider-specific default.

# Caps generated reply length in completion tokens.
MAX_COMPLETION_TOKENS=1200
